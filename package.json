{
	"name": "dnc-app",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.8.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:biome": "biome check .",
		"lint:biome:fix": "biome check --write .",
		"format": "biome format --write .",
		"commitlint": "commitlint --from HEAD~1 --to HEAD",
		"prepare": "husky"
	},
	"dependencies": {
		"next": "16.3.5",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"typescript": "^5"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,md}": [
			"biome check --write"
		]
	}
}
