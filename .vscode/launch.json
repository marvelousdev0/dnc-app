{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Next.js: debug server",
			"type": "node-terminal",
			"request": "launch",
			"command": "pnpm dev"
		},
		{
			"name": "Next.js: debug full stack",
			"type": "node-terminal",
			"request": "launch",
			"command": "pnpm dev",
			"serverReadyAction": {
				"action": "debugWithChrome",
				"killOnServerStop": true,
				"pattern": "- Local:.+(https?://.+)",
				"uriFormat": "%s"
			}
		},
		{
			"name": "Next.js: attach to server",
			"type": "node",
			"request": "attach",
			"port": 9229,
			"skipFiles": ["<node_internals>/**"]
		}
	]
}
