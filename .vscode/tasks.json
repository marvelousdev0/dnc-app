{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "dev",
			"type": "shell",
			"command": "pnpm dev",
			"isBackground": true,
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "build",
			"type": "shell",
			"command": "pnpm build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "lint",
			"type": "shell",
			"command": "pnpm lint",
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "typecheck",
			"type": "shell",
			"command": "pnpm typecheck",
			"group": "test",
			"problemMatcher": ["$tsc"]
		}
	]
}
